# Любая OpenAI-совместимая конечная точка (vLLM, провайдер gpt-oss/Qwen, Yandex AI Studio в финале)
LLM_BASE_URL=https://example/v1
LLM_API_KEY=changeme
LLM_MODEL=gpt-oss-120b
LLM_STRUCTURED_MODE=json_schema   # json_schema | json_object | prompt_only
LLM_TIMEOUT_S=120
# --- необязательные (ML1, llm/base.py) ---
LLM_REASONING_EFFORT=low          # gpt-oss: low|medium|high; пусто = не отправлять
LLM_EXTRA_BODY=                   # JSON в тело запроса, напр. {"chat_template_kwargs": {"enable_thinking": false}} для Qwen3
LLM_AUTH_SCHEME=Bearer            # Bearer | Api-Key (Yandex Cloud API-ключ)
LLM_EXTRA_HEADERS=                # JSON, напр. {"OpenAI-Project": "<folder_id>"}
LLM_MAX_RETRIES=3
LLM_LOG_PATH=out/llm_log.jsonl
